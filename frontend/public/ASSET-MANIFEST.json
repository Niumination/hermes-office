    {
      "file": "rooms/mac-studio-day.webp",
      "phase": 15,
      "tool": "scripts/recolor-wash.py",
      "args": "--from 322 --to 155 --band 34 --sat-full 0.80 --sat-none 1.01",
      "why": "Restyle pass left a magenta bounce light on the right third (wall hue 185deg left vs 327deg right). The source plate in art-backup is flat slate grey, so the colour was an artifact, not art. Magenta is in no part of this product's palette.",
      "known_effect": "The right-hand monitor's on-screen data-viz glow moved magenta -> green. That is content, not lighting, and was accepted: every other screen in the office is cyan.",
      "not_applied_to": "nap-wellness-room.webp and office-night-dm.webp also scan high for magenta (9.7% / 16.0%) but were inspected and left alone: the first is a deliberate violet night mood, the second a dusk sky through the windows. The scan is a shortlist, not a verdict."
