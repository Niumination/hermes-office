# hermes-denyut.service — denyut hidup Hermes Office
#
# Pasang (cloud, user unit — tanpa sudo):
#   cp hermes-denyut.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now hermes-denyut
#
# Periksa:
#   systemctl --user status hermes-denyut
#   journalctl --user -u hermes-denyut -f
#
# Sesuaikan User= dan jalur bila ~/.hermes bukan milik root.

[Unit]
Description=Denyut hidup Hermes Office
Documentation=https://github.com/Niumination/hermes-office/tree/dev/bridges/hermes-emit
# Kantor dan denyut boleh hidup di mesin yang sama atau tidak. Kalau sama,
# jangan pakai Requires= — denyut yang mati tidak boleh ikut menjatuhkan
# kantor, dan kantor yang restart tidak perlu menjatuhkan denyut.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agentuser
WorkingDirectory=/home/agentuser/.hermes
EnvironmentFile=/home/agentuser/.hermes/.env
ExecStart=/usr/bin/python3 /home/agentuser/.hermes/denyut.py --agent cloud --source cloud --interval 30

# Jaringan putus bukan alasan menyerah: denyut menghitung kegagalan tanpa
# melemparnya, jadi proses ini biasanya tidak mati sendiri. Restart di sini
# untuk hal yang lebih buruk — OOM, python dibunuh, mesin setengah bangun.
Restart=always
RestartSec=10

# Proses ini hanya mengirim HTTP POST. Tidak perlu apa pun yang lain.
# Denyut hanya mengirim HTTP POST + membaca ~/.hermes/.env. Hardening ringan
# yang cukup; system-level sandbox (ProtectSystem/ProtectKernel/SystemCallFilter)
# tidak berlaku di user unit dan membuat unit gagal dengan status 216/GROUP.
NoNewPrivileges=true
PrivateTmp=true

# Denyut menulis satu baris saat mulai dan satu saat berhenti. Kalau ia mulai
# berisik, itu pertanda — jangan dibungkam di sini.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
