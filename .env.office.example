# Hermes Office — environment (SECRETS ONLY). Copy to .env.office, chmod 600.
# Never commit this file. Tokens: openssl rand -hex 24

# --- Server ---
OFFICE_PORT=7333
LOG_LEVEL=info

# --- Bridge tokens (one per source) ---
OFFICE_CLOUD_TOKEN=
OFFICE_MAC_TOKEN=
OFFICE_OWNER_TOKEN=
# optional read-only guest
OFFICE_GUEST_TOKEN=

# --- Integrations ---
HERMES_API=http://127.0.0.1:3000
HERMES_A2A_MAC_URL=http://100.120.57.37:9900
HERMES_A2A_MAC_TOKEN=
GITHUB_ORG=Niumination
GITHUB_TOKEN=

# --- Origin allowlist (comma separated) — WAJIB include origin publik (mis. funnel *.ts.net), tanpa ini asset 403/blank ---
ALLOWED_ORIGINS=https://your-host.ts.net,http://127.0.0.1:7333

# --- OTLP ingest (optional) ------------------------------------------------
# Token for OpenTelemetry exporters posting to POST /v1/traces.
# Leave empty to disable OTLP ingest entirely.
OFFICE_OTLP_TOKEN=

# Safety rails for the OTLP path. Batches are much larger than /event payloads.
OTLP_MAX_BODY_SIZE=8mb
OTLP_MAX_EVENTS_PER_BATCH=2000

# --- GitHub poller ---------------------------------------------------------
# "user" | "org" | empty to auto-detect the account type.
GITHUB_OWNER_TYPE=

# --- Agent liveness watchdog -----------------------------------------------
OFFICE_WATCHDOG_CUTOFF_MS=90000
OFFICE_WATCHDOG_SWEEP_MS=30000

# --- Burn-rate governance (optional) ---------------------------------------
# Dollar caps enforced in the request path via POST /budget/check.
# 0 or unset = that scope is unlimited and the UI physics layer stays hidden.
OFFICE_BUDGET_HOURLY_USD=
OFFICE_BUDGET_DAILY_USD=
OFFICE_BUDGET_AGENT_HOURLY_USD=
# Per-agent overrides: "researcher=2.50,planner=0.75"
OFFICE_BUDGET_PER_AGENT=

# --- Floor-plan policy (optional) ------------------------------------------
# JSON document overriding the built-in floor plan. Unreadable or malformed
# files fall back to the default — the server never boots with no policy.
OFFICE_POLICY_FILE=
# Minutes a pending human approval stays open before expiring.
OFFICE_APPROVAL_TTL_MIN=5

# --- Flight Recorder (Fase 4) ------------------------------------------
# Hash-chained, append-only audit log of governance decisions.
# Evidence for EU AI Act Art. 12 (automatic logging), 14 (human oversight)
# and 19 (retention). See docs/FLIGHT-RECORDER.md — in particular the threat
# model: the chain is tamper-EVIDENT, not tamper-proof, and tail truncation
# is only detectable if you anchor GET /ledger/head somewhere external.

# On by default. An audit trail that must be switched on is one that will be
# off during the incident you needed it for.
OFFICE_LEDGER_ENABLED=1

# Separate file from office.db on purpose: different retention rule, different
# access rule, and archivable without shipping the chat history with it.
# OFFICE_LEDGER_DB=/var/lib/hermes-office/ledger.db

# Art. 19 requires at least six months. 400 days covers a full annual audit
# cycle with margin. 0 disables pruning entirely.
OFFICE_LEDGER_RETENTION_DAYS=400

OFFICE_LEDGER_CHECKPOINT_EVERY=500

# Recording permitted actions too is what makes this a complete record rather
# than an incident list; Art. 12 asks for the former. Roughly 1.1 GB/year at
# 10k decisions/day. Turn off only if write volume genuinely demands it, and
# expect an assessor to ask why.
OFFICE_LEDGER_RECORD_ALLOWS=1

# FULL = fsync every append. A decision that was enforced but not durably
# recorded is the exact gap an audit looks for.
OFFICE_LEDGER_SYNCHRONOUS=FULL
